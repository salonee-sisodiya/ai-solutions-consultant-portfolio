    {
      "parameters": {
        "jsCode": "const raw = $json.output?.[0]?.content?.[0]?.text ?? '';\nlet parsed = {};\ntry {\n  parsed = JSON.parse(String(raw).trim());\n} catch (e) {\n  parsed = {};\n}\n\nconst cartonsRaw = parsed.quantity_cartons;\nlet quantity_cartons = null;\nif (cartonsRaw !== undefined && cartonsRaw !== null && String(cartonsRaw).trim() !== '') {\n  const n = Number(String(cartonsRaw).replace(/[^0-9.]/g, ''));\n  quantity_cartons = Number.isFinite(n) ? n : null;\n}\n\nreturn [{\n  json: {\n    intent: parsed.intent ?? '',\n    phone_number: $('Process Incoming Message').item.json.from ?? '',\n    bottle_size: parsed.bottle_size ?? '',\n    quantity_cartons,\n    delivery_location: parsed.delivery_location ?? '',\n    customization: parsed.customization_required ?? '',\n    status: 'new',\n  },\n}];"
      },
