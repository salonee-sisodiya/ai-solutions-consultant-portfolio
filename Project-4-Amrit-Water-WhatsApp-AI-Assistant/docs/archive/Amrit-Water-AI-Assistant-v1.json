      "parameters": {
        "operation": "send",
        "phoneNumberId": "YOUR_WHATSAPP_PHONE_NUMBER_ID",
        "recipientPhoneNumber": "={{ $('Process Incoming Message').first().json.from }}",
        "textBody": "=✅ Order confirmed!\n\nYour Amrit Water order has been successfully confirmed.\n\nWe will process your order and keep you updated about delivery.\n\nThank you for choosing Amrit Water.",
        "additionalFields": {}
      },
      "id": "bc53da47-87df-4092-aaca-aea5523007da",
